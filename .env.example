# MongoDB Atlas connection string (e.g. mongodb+srv://<username>:<password>@cluster0.../shiplink?appName=Cluster0)
DATABASE_URL=""

# Cloudinary Cloud Name (from Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=""

# Cloudinary API Key (from Cloudinary dashboard -> API Keys)
CLOUDINARY_API_KEY=""

# Cloudinary API Secret (from Cloudinary dashboard -> API Keys)
CLOUDINARY_API_SECRET=""

# Toggle mock courier mode ("true" for simulated PostEx dispatch with MOCK- tracking numbers)
MOCK_COURIER="true"

# PostEx API Token (from PostEx merchant portal/account settings; required when MOCK_COURIER=false)
POSTEX_API_TOKEN=""

# PostEx Pickup Address Code (optional; from `npm run postex:check`. Omit to use default merchant warehouse)
POSTEX_PICKUP_ADDRESS_CODE=""
